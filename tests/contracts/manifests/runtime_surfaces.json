      "eltdx://docs/commands": {"name": "eltdx_docs_commands", "title": "eltdx commands documentation", "mime_type": "text/markdown", "path": "COMMANDS_7709.md"},
      "eltdx://docs/f10": {"name": "eltdx_docs_f10", "title": "eltdx f10 documentation", "mime_type": "text/markdown", "path": "F10_7615.md"},
      "eltdx://docs/helpers": {"name": "eltdx_docs_helpers", "title": "eltdx helpers documentation", "mime_type": "text/markdown", "path": "helpers/README.md"},
      "eltdx://docs/mcp": {"name": "eltdx_docs_mcp", "title": "eltdx mcp documentation", "mime_type": "text/markdown", "path": "MCP.md"}
    }
  },
  "cli": {
    "entry_points": {
      "eltdx-smoke": "eltdx.cli:smoke",
      "eltdx-f10-smoke": "eltdx.cli:f10_smoke",
