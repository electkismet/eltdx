    },
    "eltdx-smoke": {
      "main": "eltdx.smoke:main",
      "options": {
        "--host": {"default": null, "action": "store"},
        "--code": {"default": "sz000001", "action": "store"},
        "--history-date": {"default": null, "action": "store"},
        "--timeout": {"default": 8.0, "action": "store", "type": "float"},
        "--pool-size": {"default": 1, "action": "store", "type": "int"},
        "--probe-hosts": {"default": false, "action": "store_true"},
        "--heartbeat-interval": {"default": 30.0, "action": "store", "type": "float"},
        "--no-heartbeat": {"default": false, "action": "store_true"},
        "--quote-count": {"default": 120, "action": "store", "type": "int"},
        "--trade-count": {"default": 20, "action": "store", "type": "int"},
        "--kline-count": {"default": 5, "action": "store", "type": "int"},
        "--deep": {"default": false, "action": "store_true"}
      },
      "exit_codes": {"success": 0, "help": 0, "parse_error": 2, "invalid_counts": 1}
    },
    "eltdx-f10-smoke": {
      "main": "eltdx.f10_smoke:main",
