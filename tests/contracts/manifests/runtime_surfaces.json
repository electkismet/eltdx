  "mcp": {
    "server": {
      "name": "eltdx",
      "title": "eltdx A-share data",
      "description": "TongdaXin 7709 market data and 7615 F10 tools."
    },
    "pool_size": 4,
    "max_clients": 16,
    "tools": {
      "eltdx_quote": {"method": "quote", "signature": "(codes, timeout=8.0, host=None)", "output": "array"},
      "eltdx_quote_depth": {"method": "quote_depth", "signature": "(codes, timeout=8.0, host=None)", "output": "object"},
      "eltdx_kline": {"method": "kline", "signature": "(code, period='day', count=120, start=0, adjust=None, anchor_date=None, include_raw=False, timeout=8.0, host=None)", "output": "object"},
      "eltdx_minute": {"method": "minute", "signature": "(code, trading_date=None, include_raw=False, timeout=8.0, host=None)", "output": "object"},
      "eltdx_trades": {"method": "trades", "signature": "(code, trading_date=None, start=0, count=500, include_raw=False, timeout=8.0, host=None)", "output": "object"},
      "eltdx_call_auction": {"method": "call_auction", "signature": "(code, include_raw=False, timeout=8.0, host=None)", "output": "object"},
      "eltdx_auction_today": {"method": "auction_today", "signature": "(code, timeout=8.0, host=None)", "output": "object"},
      "eltdx_auction_history": {"method": "auction_history", "signature": "(code, trading_date, timeout=8.0, host=None)", "output": "object"},
      "eltdx_opening_match_today": {"method": "opening_match_today", "signature": "(code, timeout=8.0, host=None)", "output": "object"},
      "eltdx_opening_match_history": {"method": "opening_match_history", "signature": "(code, trading_date, timeout=8.0, host=None)", "output": "object"},
      "eltdx_auction_data": {"method": "auction_data", "signature": "(code, trading_date=None, include_series=True, include_snapshot=True, include_quote=True, pre_close_price=None, timeout=8.0, host=None)", "output": "object"},
      "eltdx_stock_profile": {"method": "stock_profile", "signature": "(codes, include_security=True, include_finance=True, timeout=8.0, host=None)", "output": "object"},
      "eltdx_shortline_indicators": {"method": "shortline_indicators", "signature": "(codes, stats_path='zhb.zip', refresh_stats=False, timeout=8.0, host=None)", "output": "object"},
      "eltdx_stock_topics": {"method": "stock_topics", "signature": "(code, timeout=8.0)", "output": "object"},
      "eltdx_topic_stocks": {"method": "topic_stocks", "signature": "(seed_code, topic_id=None, topic_name=None, sort_by='zdf', section='gndbzfsj', timeout=8.0)", "output": "object"},
      "eltdx_company_profile": {"method": "company_profile", "signature": "(code, section='8', timeout=8.0)", "output": "object"},
      "eltdx_hot_topics": {"method": "hot_topics", "signature": "(code, section='zttzbkz', timeout=8.0)", "output": "object"},
      "eltdx_finance_report": {"method": "finance_report", "signature": "(code, report_type='zcfzb', timeout=8.0)", "output": "object"},
      "eltdx_company_news": {"method": "company_news", "signature": "(code, section='gsyj', keyword='', rating='0', page=1, page_size=20, timeout=8.0)", "output": "object"},
      "eltdx_docs_index": {"method": "docs_index", "signature": "()", "output": "object"}
    },
    "resources": {
      "eltdx://docs/overview": {"name": "eltdx_docs_overview", "title": "eltdx overview documentation", "mime_type": "text/markdown", "path": "index.md"},
      "eltdx://docs/api": {"name": "eltdx_docs_api", "title": "eltdx api documentation", "mime_type": "text/markdown", "path": "API_REFERENCE.md"},
