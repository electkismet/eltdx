        "--code": {"default": "000034", "action": "store"},
        "--timeout": {"default": 8.0, "action": "store", "type": "float"}
      },
      "exit_codes": {"success": 0, "help": 0, "parse_error": 2}
    },
    "eltdx-mcp": {
      "main": "eltdx.mcp:main",
      "transport": "stdio",
      "exit_codes": {"success": 0}
