+//! Stage A source cases. Intentionally unexecuted until the T01–T30 validation gate.
+//! Include private modules so these cases need no temporary public parser API.
+#![allow(dead_code)]
+
+pub use eltdx::error;
+// Temporary fixture implementation of the future crate-private shared GBK seam.
+// Production integration must use T21's complete source-derived scalar table.
+mod encoding {
+    pub(crate) fn gbk_scalar(lead: u8, trail: u8) -> Option<char> {
+        match (lead, trail) {
+            (0xb9, 0xab) => Some('公'), (0xcb, 0xbe) => Some('司'),
+            (0xa3, 0xb0..=0xb9) => char::from_u32(0xff10 + u32::from(trail - 0xb0)),
+            _ => None,
+        }
+    }
+}
+#[path = "../src/archive.rs"]
+mod archive;
+#[path = "../src/stats.rs"]
+mod stats;
+
+use std::io::{Cursor, Write};
+use eltdx::{Error, ErrorKind};
+use zip::write::FileOptions;
+use zip::{CompressionMethod, ZipWriter};
+
+fn archive(entries: &[(&str, &[u8])], method: CompressionMethod) -> Vec<u8> {
+    let mut writer = ZipWriter::new(Cursor::new(Vec::new()));
+    for (name, contents) in entries {
+        writer.start_file(*name, FileOptions::default().compression_method(method)).expect("fixture header");
+        writer.write_all(contents).expect("fixture content");
+    }
+    writer.finish().expect("fixture finish").into_inner()
+}
+
+fn stat_line() -> String {
+    let mut parts = [""; 35];
+    for (index, value) in [(0, "0"), (1, "000001"), (2, "1.25"), (3, "8.75"),
+        (4, "20260710"), (11, "200.00"), (26, "9"), (31, "7"), (32, "5"), (33, "3")] {
+        parts[index] = value;
+    }
+    parts.join("|")
+}
+
+fn stat2_line() -> String {
+    let mut parts = [""; 21];
+    for (index, value) in [(0, "0"), (1, "000001"), (2, "20260711"), (3, "242501.84"),
+        (5, "254664.58"), (6, "851.80"), (7, "134819.47"), (8, "3468.47"),
+        (9, "11141"), (10, "9513"), (14, "6002.06"), (15, "4291.39")] {
+        parts[index] = value;
+    }
+    parts.join("|")
+}
+
+fn parse(bytes: &[u8]) -> eltdx::Result<stats::ParsedStats> {
+    stats::parse_stats_archive(bytes, "tdx://zhb.zip", &mut || Ok(()))
+}
+
+#[test]
+fn stored_and_deflated_stats_preserve_source_dates_columns_and_native_units() {
+    let stat = stat_line();
+    let stat2 = stat2_line();
+    for method in [CompressionMethod::Stored, CompressionMethod::Deflated] {
+        let bytes = archive(&[("tdxstat.cfg", stat.as_bytes()), ("tdxstat2.cfg", stat2.as_bytes())], method);
+        let parsed = parse(&bytes).expect("two valid independent table dates");
+        assert_eq!(parsed.source_path, "tdx://zhb.zip");
+        assert_eq!(parsed.stat.len(), 1);
+        assert_eq!(parsed.stat2.len(), 1);
+        let row = &parsed.stat[0];
+        assert_eq!(row.key.market_id.decimal(), "0");
+        assert_eq!(row.key.code, "000001");
+        assert_eq!(row.stats_date.as_deref(), Some("20260710"));
+        assert_eq!(row.beta_60d, Some(1.25));
+        assert_eq!(row.pe_ttm, Some(8.75));
+        assert_eq!(row.free_float_shares_10k, Some(200.0));
+        assert_eq!(row.year_limit_up_days.as_ref().map(stats::SourceInteger::decimal), Some("9"));
+        assert_eq!(row.limit_stat_days.as_ref().map(stats::SourceInteger::decimal), Some("7"));
+        assert_eq!(row.limit_up_count_in_stat_days.as_ref().map(stats::SourceInteger::decimal), Some("5"));
+        assert_eq!(row.limit_up_streak_days.as_ref().map(stats::SourceInteger::decimal), Some("3"));
+        let row2 = &parsed.stat2[0];
+        assert_eq!(row2.stats_date.as_deref(), Some("20260711"));
+        assert_eq!(row2.amount_10k, Some(242501.84));
+        assert_eq!(row2.seal_amount_10k, None);
+        assert_eq!(row2.prev_amount_10k, Some(254664.58));
+        assert_eq!(row2.prev_seal_amount_10k, Some(851.8));
+        assert_eq!(row2.prev2_amount_10k, Some(134819.47));
+        assert_eq!(row2.prev2_seal_amount_10k, Some(3468.47));
+        assert_eq!(row2.open_volume_hand, Some(11141.0));
+        assert_eq!(row2.prev_open_volume_hand, Some(9513.0));
+        assert_eq!(row2.open_amount_10k, Some(6002.06));
+        assert_eq!(row2.prev_open_amount_10k, Some(4291.39));
+    }
+}
+
+#[test]
+fn missing_duplicate_empty_and_duplicate_identity_tables_are_rejected() {
+    let stat = stat_line();
+    let stat2 = stat2_line();
+    let doubled = format!("{stat}\n{stat}");
+    for entries in [
+        vec![("tdxstat.cfg", stat.as_bytes())],
+        vec![("tdxstat.cfg", stat.as_bytes()), ("tdxstat.cfg", stat.as_bytes()), ("tdxstat2.cfg", stat2.as_bytes())],
+        vec![("tdxstat.cfg", b"short".as_slice()), ("tdxstat2.cfg", stat2.as_bytes())],
+        vec![("tdxstat.cfg", doubled.as_bytes()), ("tdxstat2.cfg", stat2.as_bytes())],
+    ] {
+        assert_eq!(parse(&archive(&entries, CompressionMethod::Stored)).expect_err("invalid table").kind(), ErrorKind::ResourceFormat);
+    }
+}
+
+#[test]
+fn python_numeric_nulls_truncation_and_unknown_source_identity_are_retained() {
+    let line = stat_line();
+    let mut parts: Vec<_> = line.split('|').collect();
+    parts[0] = "99.75";
+    parts[1] = "not-a-security";
+    parts[2] = "NaN";
+    parts[3] = "-inf";
+    parts[11] = "invalid";
+    parts[26] = "-2.9";
+    parts[31] = "1_000";
+    parts[32] = "DIGITS";
+    parts[33] = "1e100";
+    let mut changed = parts.join("|").into_bytes();
+    let digits = changed.windows(6).position(|window| window == b"DIGITS").expect("digit marker");
+    changed.splice(digits..digits + 6, [0xa3, 0xb9, b'.', 0xa3, 0xb7]);
+    let stat2 = stat2_line();
+    let parsed = parse(&archive(&[("tdxstat.cfg", &changed), ("tdxstat2.cfg", stat2.as_bytes())], CompressionMethod::Stored)).expect("source rows retained");
+    let row = &parsed.stat[0];
+    assert_eq!(row.key.market_id.decimal(), "99");
+    assert_eq!(row.key.code, "not-a-security");
+    assert_eq!(row.beta_60d, None);
+    assert_eq!(row.pe_ttm, None);
+    assert_eq!(row.free_float_shares_10k, None);
+    assert_eq!(row.year_limit_up_days.as_ref().map(stats::SourceInteger::decimal), Some("-2"));
+    assert_eq!(row.limit_stat_days.as_ref().map(stats::SourceInteger::decimal), Some("1000"));
+    assert_eq!(row.limit_up_count_in_stat_days.as_ref().map(stats::SourceInteger::decimal), Some("9"));
+    assert!(row.limit_up_streak_days.as_ref().expect("finite unbounded integer").decimal().len() > 90);
+    assert!(parsed.diagnostics.iter().any(|item| matches!(item.kind, stats::StatsDiagnosticKind::UnknownIdentity)));
+}
