+    let mut bytes = archive(&[("one", &[b'a'; 100])], CompressionMethod::Deflated);
+    bytes[33] = 0xff; // first compressed byte after 30-byte local header and name
+    assert_eq!(archive::decode_selected(&bytes, archive::ArchiveLimits::stats(), |_| true, &mut || Ok(())).expect_err("damaged deflate").kind(), ErrorKind::ResourceFormat);
+    let mut bytes = archive(&[("one", b"a"), ("two", b"b")], CompressionMethod::Stored);
+    let second = bytes.windows(4).enumerate().filter_map(|(at, value)| (value == b"PK\x01\x02").then_some(at)).nth(1).expect("second central member");
+    bytes[second + 42..second + 46].fill(0);
+    assert_eq!(archive::decode_selected(&bytes, archive::ArchiveLimits::stats(), |_| true, &mut || Ok(())).expect_err("aliased local offset").kind(), ErrorKind::ResourceFormat);
