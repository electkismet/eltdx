+#[test]
+fn signed_and_unsigned_descriptors_must_match_the_directory() {
+    for signed in [false, true] {
+        let mut bytes = archive(&[("one", b"abcdef")], CompressionMethod::Stored);
+        let central = central_start(&bytes);
+        let crc = bytes[14..18].to_vec();
+        bytes[6] |= 8;
+        bytes[14..26].fill(0);
+        bytes[central + 8] |= 8;
+        let mut descriptor = Vec::new();
+        if signed { descriptor.extend_from_slice(b"PK\x07\x08"); }
+        descriptor.extend_from_slice(&crc);
+        descriptor.extend_from_slice(&6_u32.to_le_bytes());
+        descriptor.extend_from_slice(&6_u32.to_le_bytes());
+        bytes.splice(central..central, descriptor.iter().copied());
+        let eocd = bytes.len() - 22;
+        bytes[eocd + 16..eocd + 20].copy_from_slice(&((central + descriptor.len()) as u32).to_le_bytes());
+        let decoded = archive::decode_selected(&bytes, archive::ArchiveLimits::stats(), |_| true, &mut || Ok(())).expect("valid descriptor");
+        assert_eq!(decoded[0].contents, b"abcdef");
+        let wrong_size = central + if signed { 12 } else { 8 };
+        bytes[wrong_size] = 7;
+        assert_eq!(archive::decode_selected(&bytes, archive::ArchiveLimits::stats(), |_| true, &mut || Ok(())).expect_err("descriptor mismatch").kind(), ErrorKind::ResourceFormat);
+    }
+}
