+#[test]
+fn compressed_size_and_claimed_expansion_caps_reject_before_streaming() {
+    let oversized = vec![0; 32 * 1024 * 1024 + 1];
+    let mut calls = 0;
+    let error = archive::decode_selected(&oversized, archive::ArchiveLimits::stats(), |_| { calls += 1; true }, &mut || Ok(())).expect_err("compressed cap");
+    assert_eq!(error.kind(), ErrorKind::LimitExceeded);
+    assert_eq!(calls, 0);
+    let mut bytes = archive(&[("one", b"a")], CompressionMethod::Deflated);
+    let central = central_start(&bytes);
+    bytes[central + 24..central + 28].copy_from_slice(&(32_u32 * 1024 * 1024 + 1).to_le_bytes());
+    assert_eq!(archive::decode_selected(&bytes, archive::ArchiveLimits::stats(), |_| true, &mut || Ok(())).expect_err("claimed cap").kind(), ErrorKind::LimitExceeded);
+}
