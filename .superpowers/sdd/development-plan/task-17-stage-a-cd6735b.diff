+#[test]
+fn actual_expansion_is_bounded_even_when_sizes_lie_and_cancellation_is_propagated() {
+    let mut bytes = archive(&[("one", &[b'a'; 65536])], CompressionMethod::Deflated);
+    let central = central_start(&bytes);
+    bytes[22..26].copy_from_slice(&1_u32.to_le_bytes());
+    bytes[central + 24..central + 28].copy_from_slice(&1_u32.to_le_bytes());
+    assert_eq!(archive::decode_selected(&bytes, archive::ArchiveLimits::stats(), |_| true, &mut || Ok(())).expect_err("actual length differs").kind(), ErrorKind::ResourceFormat);
+    let bytes = archive(&[("one", &[b'a'; 65536])], CompressionMethod::Deflated);
+    let selected = std::cell::Cell::new(false);
+    let mut stream_boundaries = 0;
+    let result = archive::decode_selected(&bytes, archive::ArchiveLimits::stats(), |_| { selected.set(true); true }, &mut || {
+        if selected.get() { stream_boundaries += 1; }
+        if stream_boundaries >= 3 { Err(Error::new(ErrorKind::Cancelled, "fixture cancellation")) } else { Ok(()) }
+    });
+    assert_eq!(result.expect_err("cancelled during bounded work").kind(), ErrorKind::Cancelled);
+}
