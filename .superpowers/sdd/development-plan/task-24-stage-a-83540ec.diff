+}
+#[derive(Clone, Debug)]
+pub struct InstrumentInfo { pub(crate) category: u8, pub(crate) id: ResponseIdentity, pub(crate) name: String, pub(crate) desc: String, pub(crate) record_raw: [u8; 64] }
+impl InstrumentInfo {
