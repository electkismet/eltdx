+    let history = history_transactions_request(&HistoryTransactionsQuery::new(max,last)?.with_start(i32::MAX as u32)?.with_count(65535)?);
+    assert_eq!(&current.wire()[12..],&history.wire()[16..]);
+    assert_eq!(&current.wire()[26..],&[255,255]);
+    Ok(())
+}
