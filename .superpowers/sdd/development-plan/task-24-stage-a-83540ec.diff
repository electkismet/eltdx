new file mode 100644
index 0000000..3fe23f4
--- /dev/null
+++ b/crates/eltdx/src/ex/time.rs
@@ -0,0 +1,53 @@
+//! Source-backed clock decoding; no host clock, timezone or trading calendar.
+use crate::{EventTime, Result, TradingDate};
+use super::{protocol, models::BarTimeSource, query::{BarTime, ExPeriod}};
+
+pub fn time_of_day(minutes: u16, second: u16) -> Result<EventTime> {
+    if minutes >= 24 * 60 || second > 59 { return Err(protocol("invalid EX minute/second field")); }
+    EventTime::time_of_day((minutes / 60) as u8, (minutes % 60) as u8, second as u8)
+        .map_err(|_| protocol("invalid EX clock"))
+}
+pub fn packed_date(raw: u16) -> Result<TradingDate> {
+    let year = (raw >> 11) + 2004;
+    let rest = raw % 2048;
+    TradingDate::new(year, (rest / 100) as u8, (rest % 100) as u8)
+        .map_err(|_| protocol("invalid EX packed Gregorian date").with_context("raw_date", format!("{raw}")))
+}
+pub fn day_date(raw: u32) -> Result<TradingDate> {
+    let year = u16::try_from(raw / 10000).map_err(|_| protocol("EX year overflow"))?;
+    TradingDate::new(year, ((raw % 10000) / 100) as u8, (raw % 100) as u8)
+        .map_err(|_| protocol("invalid EX YYYYMMDD date").with_context("raw_date", format!("{raw}")))
+}
+pub fn bar_time(raw: [u8; 4], period: ExPeriod, alignment: BarTime) -> Result<(EventTime, EventTime, BarTimeSource)> {
+    let (source, provenance) = if period.is_intraday() {
+        let date = packed_date(u16::from_le_bytes([raw[0], raw[1]]))?;
+        let minutes = u16::from_le_bytes([raw[2], raw[3]]);
+        time_of_day(minutes, 0)?;
+        (EventTime::local(date, (minutes / 60) as u8, (minutes % 60) as u8, 0)
+            .map_err(|_| protocol("invalid EX bar clock"))?, BarTimeSource::PackedMinute)
+    } else {
+        (EventTime::local(day_date(u32::from_le_bytes(raw))?, 15, 0, 0)
+            .map_err(|_| protocol("invalid EX daily bar clock"))?, BarTimeSource::SyntheticClose)
+    };
+    let aligned = match (alignment, period.duration_minutes()) {
+        (BarTime::End, Some(delta)) => source.add_minutes(i64::from(delta)).map_err(|_| protocol("EX bar end overflow"))?,
+        _ => source,
+    };
+    Ok((aligned, source, provenance))
+}
+
+
+/// EX clock value, independent of date and timezone. Construction is checked;
+/// seconds are retained for transaction records.
+#[derive(Clone, Copy, Debug, Eq, Hash, Ord, PartialEq, PartialOrd)]
+pub struct TimeOfDay { hour: u8, minute: u8, second: u8 }
+impl TimeOfDay {
+    pub fn new(hour: u8, minute: u8, second: u8) -> Result<Self> {
+        if hour > 23 || minute > 59 || second > 59 { return Err(super::invalid("invalid EX time of day")); }
+        Ok(Self { hour, minute, second })
+    }
+    pub const fn hour(self) -> u8 { self.hour }
+    pub const fn minute(self) -> u8 { self.minute }
+    pub const fn second(self) -> u8 { self.second }
+    pub fn as_event_time(self) -> Result<EventTime> { EventTime::time_of_day(self.hour,self.minute,self.second) }
+}
diff --git a/crates/eltdx/tests/ex_wire.rs b/crates/eltdx/tests/ex_wire.rs
new file mode 100644
index 0000000..65bc9db
--- /dev/null
+++ b/crates/eltdx/tests/ex_wire.rs
@@ -0,0 +1,400 @@
+//! Authored T24 Stage A cases. Deliberately not executed or collected until the
+//! controller permits validation after T01–T30 implementation is complete.
+#![cfg(feature = "ex")]
+use bytes::Bytes;
+use eltdx::{ErrorKind, RawPolicy, TradingDate};
+use eltdx::ex::{commands::*, config::*, frame::*, hosts::*, *};
+
+type TestResult = Result<(), Box<dyn std::error::Error>>;
+fn id() -> Result<ExInstrumentId, eltdx::Error> { Ok(ExInstrumentId::new(ExMarketId::new(31)?, ExCode::new("00700")?)) }
+fn date() -> Result<TradingDate, eltdx::Error> { TradingDate::new(2024,1,2) }
+fn hex(text: &str) -> Result<Vec<u8>, Box<dyn std::error::Error>> {
+    text.split_whitespace().map(|byte| u8::from_str_radix(byte,16).map_err(Into::into)).collect()
+}
+fn response(header: usize, count_offset: usize, width: usize, count: u16) -> Vec<u8> {
+    let mut bytes = vec![0; header + width * usize::from(count)];
+    bytes[count_offset..count_offset+2].copy_from_slice(&count.to_le_bytes()); bytes
+}
+fn put_u32(bytes: &mut [u8], offset: usize, value: u32) { bytes[offset..offset+4].copy_from_slice(&value.to_le_bytes()); }
+fn plain_frame(body: &[u8], sequence: u32, method: u32) -> Result<Vec<u8>, Box<dyn std::error::Error>> {
+    let len = u16::try_from(body.len())?;
+    let mut wire = FrameHeader::new(ENCODED_MAGIC,sequence,method,len,len).encode().to_vec();
+    wire.extend_from_slice(body); Ok(wire)
+}
+
+#[test]
+fn eleven_request_goldens_and_native_defaults() -> TestResult {
+    assert_eq!(markets_request().wire().as_ref(), hex("01 02 48 69 00 01 02 00 02 00 f4 23")?);
+    assert_eq!(instrument_count_request().wire().as_ref(), hex("01 03 48 66 00 01 02 00 02 00 f0 23")?);
+    assert_eq!(instruments_request(&InstrumentsQuery::new(0x12345678)).wire().as_ref(), hex("01 04 48 67 00 01 08 00 08 00 f5 23 78 56 34 12 64 00")?);
+    assert_eq!(quote_request(&QuoteQuery::new(id()?)).wire().as_ref(), hex("01 01 08 02 02 01 0c 00 0c 00 fa 23 1f 30 30 37 30 30 00 00 00 00")?);
+    let ql = QuoteListQuery::new(ExMarketId::new(31)?,QuoteCategory::HongKong);
